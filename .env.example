# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=reviewguard
POSTGRES_USER=reviewguard
POSTGRES_PASSWORD=reviewguard_secret
DATABASE_URL=postgresql://reviewguard:reviewguard_secret@localhost:5432/reviewguard

# ─── Vector Store ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_LLM_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-256-bit-random-secret-before-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Pipeline ─────────────────────────────────────────────────────────────────
MAX_EVIDENCE_CHUNKS=5
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=200
SIMILARITY_THRESHOLD=0.60

# ─── Circuit Breaker ──────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_RESET_TIMEOUT=30
